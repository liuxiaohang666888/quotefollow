# ===== Vertical =====
# 垂直行业标识：默认为 quotefollow，可选 hvac/law/insure/plumber/electrician
NEXT_PUBLIC_VERTICAL=quotefollow
# 品牌名：默认为 QuoteFollow，子域名如 HVACFollow 等
NEXT_PUBLIC_BRAND_NAME=QuoteFollow

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== OpenAI（也可填智谱 GLM 的 OpenAI 兼容地址，见 README） =====
OPENAI_API_KEY=sk-xxx
# 默认 https://api.openai.com/v1；用智谱填 https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== Resend（发跟进邮件） =====
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Followup <followup@yourdomain.com>

# ===== 站点 =====
# 你的生产域名（Vercel 部署后形如 https://xxx.vercel.app，可绑自定义域名）
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Landing 页 "Get Started" 按钮：优先用 PayPal 订阅计划（自动月付 $29），回退才用发票链接
# PayPal 订阅计划（在 PayPal 后台「定期付款计划」创建后拿 plan_id）
NEXT_PUBLIC_PAYPAL_PLAN_ID=P-xxxxxxxxxxxxxxx
# PayPal SDK 的 client-id（创建订阅计划页面生成的 script 标签里有，或以商家身份在 developer.paypal.com 拿）
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# 当未配置订阅计划时的回退发票链接（年付卡片等用）
NEXT_PUBLIC_PAYPAL_INVOICE_URL=https://www.paypal.com/invoice/s/xxx

# ===== 入站邮件 Webhook 鉴权（Cloudflare Worker 转发时带） =====
INBOUND_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ===== Cron 鉴权（Vercel Cron 默认用 CRON_SECRET，也可留空仅靠 Vercel 内部） =====
CRON_SECRET=change-me-to-another-long-random-string

# ===== 付费墙 =====
# 管理员/开发者邮箱白名单（逗号分隔，客户端可读）：这些邮箱免订阅直接进 dashboard，用于你自己测试
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com
# PayPal 服务端凭据（可选）：配置后 signup 会真实调用 PayPal API 验证订阅是否 ACTIVE（防白嫖最彻底）。
# 未配置时回退为"订阅 ID 必须是 I- 开头"格式校验。
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
