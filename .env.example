# ===== Vertical =====
# 垂直行业标识：默认为 quotefollow，可选 hvac/law/insure/plumber/electrician
NEXT_PUBLIC_VERTICAL=quotefollow
# 品牌名：默认为 QuoteFollow，子域名如 HVACFollow 等
NEXT_PUBLIC_BRAND_NAME=QuoteFollow

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== OpenAI（也可填智谱 GLM 的 OpenAI 兼容地址，见 README） =====
OPENAI_API_KEY=sk-xxx
# 默认 https://api.openai.com/v1；用智谱填 https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== Resend（发跟进邮件） =====
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Followup <followup@yourdomain.com>
# Resend 入站 webhook 的 Svix 签名密钥（Resend 后台 Webhooks 页面 whsec_ 开头）。
# 入站路由 /api/webhooks/inbound 用它验签；未配置时 Svix 通道关闭（只剩 Worker 共享密钥通道）。
RESEND_WEBHOOK_SIGNING_SECRET=whsec_xxx
# 站主通知邮箱：Affiliate waitlist 有人填表时发通知邮件。未配置时静默跳过，不影响申请流程。
OWNER_EMAIL=you@yourdomain.com

# ===== 站点 =====
# 你的生产域名（Vercel 部署后形如 https://xxx.vercel.app，可绑自定义域名）
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ===== PayPal =====
# 三档订阅计划 ID（在 PayPal 后台「定期付款计划」创建后拿 plan_id，形如 P-xxxxxxxx）。
# ⚠️ 任一档位缺失时，对应购买按钮会显示"暂不可用"而不会静默按别的计划扣款
#    （防止 Early Bird $29 / Yearly $490 用户被按 Pro 计划错价扣款）。
#    Pro 档缺失时回退到代码内置的生产计划（同计划同价，不算错价）。
NEXT_PUBLIC_PAYPAL_PRO_PLAN_ID=P-xxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYPAL_EARLY_BIRD_PLAN_ID=P-xxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYPAL_YEARLY_PLAN_ID=P-xxxxxxxxxxxxxxx
# 兼容旧变量名：Pro 档 plan ID 的备选读取位（可选）
NEXT_PUBLIC_PAYPAL_PLAN_ID=P-xxxxxxxxxxxxxxx
# PayPal SDK 的 client-id（创建订阅计划页面生成的 script 标签里有，或以商家身份在 developer.paypal.com 拿）
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# 当未配置订阅计划时的回退发票链接（年付卡片等用）
NEXT_PUBLIC_PAYPAL_INVOICE_URL=https://www.paypal.com/invoice/s/xxx
# PayPal 服务端凭据：配置后 signup 会真实调用 PayPal API 验证订阅是否 ACTIVE（防白嫖最彻底）。
# 未配置时回退为"订阅 ID 必须是 I- 开头"格式校验。
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal Webhook ID（developer.paypal.com → Webhooks 页面，验签 transmission id 用）
PAYPAL_WEBHOOK_ID=
# PayPal 环境：生产留空或填 live；联调填 sandbox（切 api-m.sandbox.paypal.com）
PAYPAL_ENV=

# ===== 入站邮件 Webhook 鉴权（Cloudflare Worker 转发时带） =====
INBOUND_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Cloudflare Worker 的调试入口 token（wrangler secret put DEBUG_TOKEN）。
# 配置后访问 https://<worker-url>/?debug=<token> 且带 X-Inbound-Secret 头可模拟一封邮件；
# 不配置则调试入口关闭（404）。
DEBUG_TOKEN=

# ===== Cron 鉴权（Vercel Cron 默认用 CRON_SECRET，也可留空仅靠 Vercel 内部） =====
CRON_SECRET=change-me-to-another-long-random-string

# ===== 付费墙 =====
# 管理员/开发者邮箱白名单（逗号分隔，客户端可读）：这些邮箱免订阅直接进 dashboard，用于你自己测试
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com
